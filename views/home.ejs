<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <nav>
        <% if(user){ %>
            <a class="nav-b" href="/create">Create Post</a>
            <a class="nav-b" href="/logout">Logout</a>
            <% if(!user.isadmin){ %>
                <a class="nav-b" href="/admin">Be an Admin</a>
            <% } %>
            <% if(!user.ismember){ %>
                <a class="nav-b" href="/member">Be a Member</a>
            <% } %>
        <% } %>
        <% if(!user){ %>
            <a class="nav-b" href="/login">Login</a>
            <a class="nav-b" href="/sign-up">Sign Up</a>
        <% } %>
    </nav>
    <h1>Very Very Secret Club</h1>
    <% if(posts){ %>
        <% posts.map((post) => { %>
            <div class="post">
                <p class="title"><%= post.title %></p>
                <p><%= post.content %></p>
                <% if(user && user.ismember){ %>
                    <p class="date"><%= post.time.toLocaleString() %></p>
                    <p class="user"><%= post.user %></p>
                <% } %>
                <% if(user && user.isadmin){ %>
                    <form action="/delete/<%=post.id%>" method="POST">
                        <button type="submit" class="form-b">Delete Post</button>
                    </form>
                <% } %>
            </div>
        <% }) %>
    <% } %>
</body>
</html>